FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8080

WORKDIR /app
RUN addgroup --system app && adduser --system --ingroup app app && chown app:app /app

COPY requirements.txt requirements-migration.txt ./
RUN pip install --no-cache-dir -r requirements-migration.txt

COPY minio_migration.py minio_catalog.py ./
COPY templates/minio_migration.html templates/
USER app
CMD ["sh", "-c", "exec gunicorn minio_migration:app --bind 0.0.0.0:${PORT} --workers 1 --timeout 300 --access-logfile -"]
